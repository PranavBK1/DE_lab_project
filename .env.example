# Copy to .env and fill in real values. Never commit .env.

# --- PostgreSQL connection ---
PG_HOST=localhost
PG_PORT=5432
PG_DB=movielens

# Superuser: used only by setup / ETL scripts
PG_SUPERUSER=postgres
PG_SUPERPASSWORD=change-me

# Passwords for the DB roles created by sql/roles.sql
MOVIE_ADMIN_PASSWORD=change-me
MOVIE_APP_USER_PASSWORD=change-me

# Demo app accounts (seeded in Phase 5)
# DEMO_ADMIN_PASSWORD=change-me
# DEMO_USER_PASSWORD=change-me
